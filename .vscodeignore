# Files excluded from the packaged .vsix.
#
# Keep: src/, python/, syntax/, themes/, media/, package.json, README.md,
# LICENSE, *language-configuration.json -- everything the extension needs
# at run time.

.vscode/**
.github/**
.git/**
.gitignore
.vscodeignore

# Development-only
test/**
tools/**
EXTENSION.md
# node_modules: everything but the runtime deps of src/invalid.js
node_modules/**
!node_modules/vscode-textmate/**
!node_modules/vscode-oniguruma/**
jsconfig.json

# Caches and build leftovers
**/__pycache__/**
**/*.pyc
**/.DS_Store
*.vsix
