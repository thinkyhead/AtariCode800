# SYNTAX TEST "source.ataribasic" "AtariBASIC scope tests"

10 PRINT "HELLO"
#  ^^^^^ keyword.print.ataribasic
#        ^ punctuation.definition.string.open.ataribasic

20 A=1
#  ^ variable.float.ataribasic
#   ^ keyword.operator.assignment.ataribasic
#    ^ constant.numeric.float.ataribasic

30 A=1:B=2
#     ^ support.token.delimiter.statement.ataribasic
#      ^ variable.float.ataribasic
#        ^ constant.numeric.float.ataribasic

40 PRINT "A":PRINT "B"
#           ^ support.token.delimiter.statement.ataribasic
#            ^^^^^ keyword.print.ataribasic

50 IF NOT XYZ THEN ?
#  ^^ keyword.if.ataribasic
#     ^^^ keyword.operator.logic.ataribasic
#         ^^^ ctx.cmd_if.ataribasic
#             ^^^^ keyword.then.ataribasic

60 IFNOTXYZ THEN?
#  ^^ keyword.if.ataribasic
#    ^^^ keyword.operator.logic.ataribasic
#       ^^^ ctx.cmd_if.ataribasic

110 IF A THEN 20
#   ^^ keyword.if.ataribasic
#      ^ variable.float.ataribasic
#        ^^^^ keyword.then.ataribasic
#             ^^ constant.numeric.line-number.ataribasic

120IFNOTYN THENRET.
#  ^^ keyword.if.ataribasic
#    ^^^ keyword.operator.logic.ataribasic
#       ^^ variable.float.ataribasic
#          ^^^^ keyword.then.ataribasic
#              ^^^^ keyword.return.ataribasic

70 FOR I=1 TO 10
#  ^^^ keyword.for.ataribasic
#          ^^ keyword.to.ataribasic

80 NEXT I
#  ^^^^ keyword.next.ataribasic

90 REM a comment
#  ^^^ keyword.rem.ataribasic

100 DIM F$(10),N$(12)
#   ^^^ keyword.dim.ataribasic

130 LET A$="X":B=1
#   ^^^ keyword.let.ataribasic
#       ^^ variable.string.ataribasic
#              ^ variable.float.ataribasic

140 ?"A";B,C
#       ^ support.token.delimiter.concat.ataribasic
#        ^ variable.float.ataribasic
#         ^ support.token.delimiter.tab.ataribasic

150 BYE:?"X"
#       ^ invalid.warning.dead-code.ataribasic

160 A=PEEK(3)*2
#            ^ keyword.operator.math.ataribasic

170 ?PEEK(1);3
#           ^ support.token.delimiter.concat.ataribasic

180 POKE 1 ,2
#          ^ support.token.delimiter.list.1.ataribasic

190 ?1 ;2
#      ^ support.token.delimiter.concat.ataribasic

200 ON PEEK(1) GOTO 5
#              ^^^^ keyword.on-goto.ataribasic

210 IF J1/N8=INT(J1/N8) THEN 1000
#                       ^^^^ keyword.then.ataribasic

220 A=PEEK(1) * 2
#             ^ keyword.operator.math.ataribasic
