{
  "$schema": "vscode://schemas/color-theme",
  "name": "Atari800 Dark",
  "type": "dark",
  "colors": {
    "editor.foreground": "#4d7498",
    "editor.background": "#0a3357",
    "editorCursor.foreground": "#ffff00",
    "editorWhitespace.foreground": "#4d749880",
    "editor.lineHighlightBackground": "#0a3357a1",
    "editor.selectionBackground": "#486e9280",
    "editorGutter.background": "#000000",
    "editor.findMatchBackground": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#4d7498"
      }
    },
    {
      "name": "Constant",
      "scope": "constant",
      "settings": {
        "foreground": "#b2b2b2ba"
      }
    },
    {
      "name": "Entity",
      "scope": "entity",
      "settings": {
        "foreground": "#a6a683cc"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#6e8da1d1"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "foreground": "#6ea18dd1"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "foreground": "#4d7498"
      }
    },
    {
      "name": "Statement Delimiter",
      "scope": "support.token.delimiter.statement",
      "settings": {
        "foreground": "#001221"
      }
    },
    {
      "name": "String",
      "scope": "string, string.unquoted.heredoc string",
      "settings": {
        "foreground": "#4d7498"
      }
    },
    {
      "name": "Comment",
      "scope": "comment, keyword.rem",
      "settings": {
        "foreground": "#886688"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "foreground": "#6b6b6b"
      }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": {
        "foreground": "#a6a683cc"
      }
    },
    {
      "name": "Lang Variable",
      "scope": "variable.language",
      "settings": {
        "foreground": "#4d7498"
      }
    },
    {
      "name": "Function Call",
      "scope": "meta.function-call",
      "settings": {
        "foreground": "#536bb2"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid.warning",
      "settings": {
        "background": "#6b4317",
        "foreground": "#e0a050",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid.error",
      "settings": {
        "background": "#700005",
        "foreground": "#ff5060",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "background": "#700005",
        "foreground": "#ff5060",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Embedded Source",
      "scope": "text source, string.unquoted.heredoc, source source",
      "settings": {
        "foreground": "#4d7498",
        "background": "#172530"
      }
    },
    {
      "name": "Entity inherited-class",
      "scope": "entity.other.inherited-class",
      "settings": {
        "foreground": "#4d7498",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String embedded-source",
      "scope": "string.quoted source",
      "settings": {
        "foreground": "#4d7498"
      }
    },
    {
      "name": "String constant",
      "scope": "string constant",
      "settings": {
        "foreground": "#4d7498"
      }
    },
    {
      "name": "String.regexp",
      "scope": "string.regexp",
      "settings": {
        "foreground": "#4d7498"
      }
    },
    {
      "name": "String variable",
      "scope": "string variable",
      "settings": {
        "foreground": "#4d7498"
      }
    },
    {
      "name": "Support.function",
      "scope": "support.function",
      "settings": {
        "foreground": "#536bb2"
      }
    },
    {
      "name": "Support.constant",
      "scope": "support.constant",
      "settings": {
        "foreground": "#4d7498"
      }
    },
    {
      "name": "Exception",
      "scope": "support.type.exception",
      "settings": {
        "foreground": "#b21500"
      }
    },
    {
      "name": "C/C++ Preprocessor Line",
      "scope": "meta.preprocessor.c",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "C/C++ Preprocessor Directive",
      "scope": "meta.preprocessor.c keyword",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "Doctype/XML Processing",
      "scope": "meta.sgml.html meta.doctype, meta.sgml.html meta.doctype entity, meta.sgml.html meta.doctype string, meta.xml-processing, meta.xml-processing entity, meta.xml-processing string",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "Meta.tag.A",
      "scope": "meta.tag, meta.tag entity",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "css tag-name",
      "scope": "meta.selector.css entity.name.tag",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "css#id",
      "scope": "meta.selector.css entity.other.attribute-name.id",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "css.class",
      "scope": "meta.selector.css entity.other.attribute-name.class",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "css property-name:",
      "scope": "support.type.property-name.css",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "css property-value;",
      "scope": "meta.property-group support.constant.property-value.css, meta.property-value support.constant.property-value.css",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "css @at-rule",
      "scope": "meta.preprocessor.at-rule keyword.control.at-rule",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "css additional-constants",
      "scope": "meta.property-value support.constant.named-color.css, meta.property-value constant",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "css constructor.argument",
      "scope": "meta.constructor.argument.css",
      "settings": {
        "foreground": "#b2b200"
      }
    },
    {
      "name": "diff.header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "foreground": "#b2b200",
        "background": "#000012"
      }
    },
    {
      "name": "diff.deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#b2b200",
        "background": "#350600"
      }
    },
    {
      "name": "diff.changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#b2b200",
        "background": "#594e00"
      }
    },
    {
      "name": "diff.inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#b2b200",
        "background": "#0f3700"
      }
    },
    {
      "name": "Raw Markup",
      "scope": "markup.raw",
      "settings": {
        "background": "#649bac30"
      }
    },
    {
      "name": "Block Quote",
      "scope": "markup.quote",
      "settings": {
        "background": "#00305a"
      }
    },
    {
      "name": "List",
      "scope": "markup.list",
      "settings": {
        "background": "#0d091a"
      }
    },
    {
      "name": "Bold Markup",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#b2b200",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic Markup",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#b2b200",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Heading Markup",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#b2b200",
        "background": "#000d17",
        "fontStyle": "bold"
      }
    }
  ]
}
